# Copy to .env (kept out of version control) before running the app.

# TMDB API key used for browsing/search metadata (same key the reference
# ARKPlay web app uses; get your own free key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# Base URL of your deployed ARKVideoScrapper instance.
# Local dev default assumes the scraper is running on the same machine.
SCRAPER_BASE_URL=https://ark-video-scrapper.vercel.app

# Wyzie Subs key - lets the app search subtitles directly (see
# lib/services/external_subtitle_service.dart), independent of the
# scraper. Free key from https://store.wyzie.io/redeem.
WYZIE_SUBS_API_KEY=
